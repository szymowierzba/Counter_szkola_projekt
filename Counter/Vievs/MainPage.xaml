<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Counter.Views.MainPage"
    Title="Counter"
    BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Counter"
            FontSize="30"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="Black"/>

        <Entry
            x:Name="CounterNameEntry"
            Placeholder="Podaj nazwę licznika"
            TextColor="Black"/>

        <Button
            Text="Dodaj licznik"
            BackgroundColor="LightGray"
            TextColor="Black"
            Clicked="AddCounter_Clicked"/>

        <Button
            Text="Zapisz liczniki"
            BackgroundColor="LightGreen"
            TextColor="Black"
            Clicked="SaveCounters_Clicked"/>

        <VerticalStackLayout
            x:Name="CountersLayout"
            Spacing="10"/>

    </VerticalStackLayout>

</ContentPage>
